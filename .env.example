# Backend Configuration
# Supported backends: jaeger, tempo, traceloop, datadog, sentry, xray, newrelic, honeycomb
BACKEND_TYPE=jaeger

# Backend URL (required)
# Examples:
#   Jaeger: http://localhost:16686
#   Tempo: http://localhost:3200
#   Traceloop: https://api.traceloop.com (NOT .../v2 - every Traceloop
#     endpoint this backend calls already starts with /v2 itself, so a
#     BACKEND_URL that includes /v2 doubles the path segment and 404s on
#     every request regardless of credentials; confirmed live)
#   Datadog (US): https://api.datadoghq.com
#   Datadog (EU): https://api.datadoghq.eu
#   Sentry (SaaS): https://sentry.io
#   Sentry (self-hosted): https://sentry.your-company.com
#   AWS X-Ray: https://xray.<region>.amazonaws.com (e.g. https://xray.us-east-1.amazonaws.com) -
#     decorative only, never dereferenced for a live request; see BACKEND_AWS_REGION below
#   New Relic (US): https://api.newrelic.com/graphql
#   New Relic (EU): https://api.eu.newrelic.com/graphql
#   Honeycomb (US): https://api.honeycomb.io
#   Honeycomb (EU): https://api.eu1.honeycomb.io
# Must NOT embed credentials (user:password@host) - the server refuses to
# start, because the URL is logged, printed by --print-config/doctor and
# echoed by backend error text. Use BACKEND_API_KEY (Bearer) or
# BACKEND_TEMPO_INSTANCE_ID + BACKEND_API_KEY (Basic) below instead.
BACKEND_URL=http://localhost:16686

# Optional: API key for authenticated backends (mainly for Traceloop, required
# for Datadog, Sentry, New Relic, and Honeycomb - for Sentry this is an auth
# token with trace/event read permissions; for New Relic this must be a User
# API key, not an Ingest or License key; for Honeycomb this must be a
# Configuration Key, not an Ingest or Management key)
BACKEND_API_KEY=

# Required for Datadog backend only: Application key, in addition to BACKEND_API_KEY
BACKEND_APP_KEY=

# Required for Grafana Cloud-hosted Tempo only: the stack/instance ID, used
# together with BACKEND_API_KEY (a Cloud Access Policy token) for Basic Auth.
# Not needed for self-hosted Tempo.
BACKEND_TEMPO_INSTANCE_ID=

# Required for Sentry backend only: organization slug (every Sentry API
# endpoint this backend uses is organization-scoped).
BACKEND_SENTRY_ORG=

# Optional for Sentry backend: project slug to narrow queries to. When
# omitted, queries span every project the auth token can access.
BACKEND_SENTRY_PROJECT=

# Required for AWS X-Ray backend only: the AWS region to query (e.g. us-east-1).
# X-Ray uses boto3's standard credential chain (environment variables, shared
# ~/.aws/credentials, an assumed role, or an instance/task role) - not
# BACKEND_API_KEY. Ensure the running process has xray:GetTraceSummaries,
# xray:BatchGetTraces, and xray:GetServiceGraph permissions.
BACKEND_AWS_REGION=

# Required for New Relic backend only: the account ID to query. A User API
# key is user-scoped, not account-scoped, so every NerdGraph query needs
# this to know which account's data to read.
BACKEND_NEWRELIC_ACCOUNT_ID=

# Required for Honeycomb backend only: the dataset slug to query. The Query
# Data API is dataset-scoped. NOTE: the research behind this backend found
# the programmatic Query Data API (the only way to actually run a query and
# get results back) is documented as Enterprise-plan exclusive - see the
# module docstring in src/opentelemetry_mcp/backends/honeycomb.py.
BACKEND_HONEYCOMB_DATASET=

# Optional: Comma-separated list of environments for Traceloop backend (default: production)
# Only used when BACKEND_TYPE=traceloop
BACKEND_ENVIRONMENTS=production

# Optional: Request timeout in seconds (default: 30). On Honeycomb this also
# bounds how long a query may wait for a free slot of the shared 10/min Create
# Query Result budget before failing with HoneycombRateLimitedError. Also derives
# the total deadline of one logical backend request (connect, retries and their
# sleeps, every redirect hop and the whole body read): max(30 s, 4 x
# BACKEND_TIMEOUT); past it the call fails with BackendDeadlineExceededError.
BACKEND_TIMEOUT=30

# Optional: ceiling on the DECODED size of any single backend response, in
# bytes (default: 67108864 = 64 MiB, range 1 to 1073741824). httpx inflates
# gzip/deflate bodies transparently, so this bounds how much heap one backend
# (or redirect-target) response can claim in the shared server process; an
# oversized body fails with ResponseTooLargeError instead of being buffered.
# Raise it if legitimate large trace queries are rejected. The secondary
# backend has its own SECONDARY_BACKEND_MAX_RESPONSE_BYTES. Bodies are inflated
# incrementally under the cap (peak memory is bounded, not just the buffered
# size); only gzip/deflate are accepted - brotli, zstd or an unknown
# Content-Encoding is refused before the body is read.
BACKEND_MAX_RESPONSE_BYTES=67108864

# Optional: a second, independently-configured backend for the
# correlate_trace tool (cross-backend correlation). Every BACKEND_* field
# above has a SECONDARY_BACKEND_* equivalent (SECONDARY_BACKEND_API_KEY,
# SECONDARY_BACKEND_SENTRY_ORG, SECONDARY_BACKEND_AWS_REGION, etc.). Unset
# by default - correlate_trace raises a clear error if called with no
# secondary backend configured. There is no CLI override for this (env
# vars only); see config.py's ServerConfig.secondary_backend docstring.
# Left commented out (not blank) since, unlike every other optional field
# in this file, an uncommented-but-empty SECONDARY_BACKEND_TYPE is treated
# the same as leaving it unset - uncomment and fill in both lines to opt in.
# SECONDARY_BACKEND_TYPE=
# SECONDARY_BACKEND_URL=

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: when OTel self-instrumentation is enabled (OTEL_EXPORTER_OTLP_ENDPOINT
# set), adopt the W3C trace context a caller places under a request's
# params._meta as the parent of this server's own spans. Default: true for
# stdio (the only caller is the trusted parent process), false for
# --transport http (any peer could otherwise choose the trace identity the
# server's spans and correlated log lines are filed under).
# MCP_TRUST_CLIENT_TRACE_CONTEXT=false

# Optional: standard OTel SDK sampler override. Unset, tracehub-mcp installs a
# sampler that records its own spans regardless of a caller's traceparent
# trace-flags; set it and the SDK's own resolution wins.
# OTEL_TRACES_SAMPLER=always_on

# Optional: Maximum traces per query (default: 500, max: 1000)
MAX_TRACES_PER_QUERY=500

# Optional: cache backend query results (search_traces/search_spans/get_trace/
# list_services/get_service_operations) for this many seconds, with in-flight
# request coalescing. Must be finite, > 0 and at most 86400 (one day). Cached
# results live in the server process's memory, shared by every MCP session.
# (default: unset/disabled)
# QUERY_CACHE_TTL_SECONDS=30

# Optional: upper bound on the number of cached query results held at once when
# QUERY_CACHE_TTL_SECONDS is set (1-100000). The least-recently-used entry is
# evicted first, independent of the TTL. (default: 1024)
# QUERY_CACHE_MAX_ENTRIES=1024

# Optional: Max requests per TCP peer address per RATE_LIMIT_WINDOW_SECONDS on
# the HTTP transport (only for --transport http, default: 100, set to 0 to
# disable). Behind a reverse proxy every client shares the proxy's bucket
# unless FORWARDED_ALLOW_IPS below names the proxy. A negative value is
# refused at startup.
RATE_LIMIT_MAX_REQUESTS=100

# Optional (HTTP transport only): comma-separated proxy IPs/CIDRs (or *) whose
# X-Forwarded-For may replace the TCP peer address as the rate-limit key - the
# same variable uvicorn honours. Unset: the header is never trusted, not even
# from 127.0.0.1 (uvicorn's own implicit default is deliberately not applied).
# Configure the proxy to overwrite or append X-Forwarded-For rather than pass
# the client's header through. `*` trusts every hop, so any client can set
# X-Forwarded-For and choose its own rate-limit key - name the proxy addresses
# instead; an entry that is not an IP literal or a strict CIDR is refused at
# startup. (default: unset)
# FORWARDED_ALLOW_IPS=

# Optional: Fixed window size in seconds for RATE_LIMIT_MAX_REQUESTS (default:
# 60). Must be finite and greater than 0 - 0, a negative value, inf or nan is
# refused at startup.
RATE_LIMIT_WINDOW_SECONDS=60

# Optional (HTTP transport only): GET /ready memoizes its backend probe
# (health_check + list_services) for this many seconds - a failed probe for at
# most 5 s - and concurrent probes share one in-flight check, so any number of
# unauthenticated readiness requests cost the backend at most one probe per
# window. A probe that has not answered after 10 s returns 503. Set to 0 to
# disable the memo (the timeout and in-flight sharing stay). A failing probe's
# 503 body names only an error class (backend unreachable / timeout / error
# <status> / unhealthy); the redacted detail is logged at WARNING and never
# returned to the unauthenticated caller. (default: 30)
# READINESS_CACHE_SECONDS=30

# Optional (HTTP transport only): close a streamable-HTTP session that has had
# no request for this many seconds (must be > 0, default: 1800 = the mcp SDK
# default). An idle session's id answers 404 and clients re-initialize; this
# bounds how long one peer can hold entries in the shared 10,000-session
# table. Already-deployed containers can set fastmcp's own
# FASTMCP_HTTP_SESSION_IDLE_TIMEOUT as a no-code stopgap.
# SESSION_IDLE_TIMEOUT_SECONDS=1800

# Optional (HTTP transport only): serve each /mcp request on a fresh transport
# with no session tracking at all - no per-peer state outlives a request, at
# the cost of the GET SSE stream used for server-initiated notifications
# (default: false)
# MCP_STATELESS_HTTP=false

# Optional: On HTTP transport shutdown, wait this many seconds inside the ASGI
# shutdown handler (after in-flight connections are already drained) before
# closing the backend client (default: 0, disabled)
SHUTDOWN_DRAIN_SECONDS=0

# Optional: On HTTP transport, abandon closing the backend client during
# shutdown if it does not finish within this many seconds - uvicorn places no
# timeout of its own around this wait (default: 5)
BACKEND_CLOSE_TIMEOUT_SECONDS=5

# Optional: On HTTP transport, uvicorn's own bound (whole seconds only) on
# waiting for in-flight connections/tasks to finish on shutdown before
# cancelling them (default: 2)
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=2

# Optional (HTTP transport only): shared bearer token every /mcp request must
# present as `Authorization: Bearer <token>` (at least 32 characters, e.g.
# `openssl rand -hex 32`). Required whenever MCP_HOST is not loopback unless
# MCP_ALLOW_UNAUTHENTICATED_HTTP=true; /health and /ready never need it.
# Left commented out: this file is an example, not a secrets store - set the
# real value in the deployment's environment. A blank value (set but empty)
# is a startup error, not "unset"; the value must be printable ASCII without
# whitespace.
# MCP_HTTP_BEARER_TOKEN=

# Optional (HTTP transport only): acknowledge serving /mcp on a non-loopback
# MCP_HOST with no token - every network peer that can reach the port runs
# every tool under the operator's backend credential (default: false, the
# server refuses to start instead)
# MCP_ALLOW_UNAUTHENTICATED_HTTP=false

# Optional (HTTP transport only): comma-separated hostnames/IP literals
# accepted in the Host header besides loopback names and the bound address;
# any other Host answers 421 before any route runs (DNS-rebinding defence).
# A loopback MCP_HOST validates Host automatically; a 0.0.0.0 bind (the
# Docker CMD) only validates once this names its public hostnames - set it for
# every container reachable beyond its host; the single value * disables Host
# validation and must stand alone (mixing * with names is refused at startup,
# as is an entry that is not a hostname or IP literal - hostname labels may
# contain letters, digits, hyphens and underscores, so a Docker Compose
# service name such as trace_hub is accepted) (default: unset)
# MCP_ALLOWED_HOSTS=
